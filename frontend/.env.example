# Don't fill this in by hand — after `terraform apply` succeeds, run
# scripts/generate_frontend_env.sh from the repo root. It writes
# frontend/.env.production and frontend/.env.development for you from the
# live Terraform outputs. See docs/deployment.md.
VITE_API_ENDPOINT=
VITE_AWS_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_HOSTED_UI_DOMAIN=
